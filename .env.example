# AI provider: grok | claude
LLM_PROVIDER=grok
XAI_API_KEY=
XAI_MODEL=grok-4.7               # any xAI model with image input (GET /v1/language-models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Instagram Graph API (Instagram Business/Creator account)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0
# Public HTTPS URL where this server is reachable (Instagram downloads the MP4 from PUBLIC_BASE_URL/renders/...)
# Also required for Shotstack when media lives on local disk (presigned/local get URLs must be absolute).
PUBLIC_BASE_URL=

PORT=3000

# Cloudflare R2 storage (S3-compatible). If unset, files are stored on local disk under data/store.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Render backend: auto | ffmpeg | shotstack
# auto (default) uses Shotstack when SHOTSTACK_API_KEY is set, otherwise ffmpeg.
RENDER_PROVIDER=auto
SHOTSTACK_API_KEY=
# stage = sandbox (default); v1 = production (paid, no watermark)
SHOTSTACK_ENV=stage
# Max time to wait for a Shotstack render (ms)
SHOTSTACK_TIMEOUT_MS=300000
SHOTSTACK_POLL_MS=2500
# If true, do not fall back to ffmpeg when Shotstack fails
SHOTSTACK_STRICT=

# "Your AI Twin" path. Off by default (and off in production).
ENABLE_AI_TWIN=0
HEYGEN_API_KEY=
# 1 = call HeyGen v3 for real (needs the key). Unset = stub data, no network.
HEYGEN_LIVE=
# HeyGen v3 has NO free test mode (v1/v2 test:true was retired 2026-10-31): every render is billed.
# Renders run only when this is 1, which needs the owner's OK to spend.
HEYGEN_ALLOW_SPEND=
# empty = avatar_iii (cheapest, $0.99/min studio avatar). avatar_iv / avatar_v only if set explicitly.
# Every render is refused before calling HeyGen if the estimate is over $0.50 or 30s.
HEYGEN_ENGINE=
# comma-separated stock avatar look ids shown as "Sample", and the stock voice used with them
HEYGEN_STOCK_AVATAR_IDS=
HEYGEN_STOCK_VOICE_ID=
# Runway (M3 B-roll). Billed per generated second: gen4_turbo 5 credits/s ($0.05/s), gen4.5 12 credits/s.
# Live needs the key + RUNWAY_LIVE=1; any generation also needs RUNWAY_ALLOW_SPEND=1. Keep both unset in production.
RUNWAYML_API_SECRET=
RUNWAY_LIVE=
RUNWAY_ALLOW_SPEND=
RUNWAY_API_VERSION=2024-11-06
# Optional: gen4.5 (2.4x the price). Default gen4_turbo.
RUNWAY_MODEL=
RUNWAY_SESSION_CAP_USD=5
# Optional: put the stock avatar in a licensed salon interior (HeyGen image background + remove_background).
# Off in production until approved. Needs a public HTTPS URL of public/twin/salon_interior.jpg
# (TWIN_SALON_BACKGROUND_URL, TWIN_SALON_BACKGROUND_ASSET_ID, or PUBLIC_BASE_URL + /twin/salon_interior.jpg).
TWIN_SALON_BACKGROUND=0
TWIN_SALON_BACKGROUND_URL=
# TWIN_SALON_BACKGROUND_ASSET_ID=
# Slow ffmpeg push-in (~4%) when the salon background is on. Set 0 to disable.
# TWIN_SALON_PUSH_IN=0.04
# Twin go-live guards
ENABLE_TWIN_CREATION=
DAILY_SPEND_CAP_USD=5
PAID_RENDERS_PER_IP_PER_DAY=3

