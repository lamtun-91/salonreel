# AI provider: grok | claude
LLM_PROVIDER=grok
XAI_API_KEY=
XAI_MODEL=grok-4.7               # any xAI model with image input (GET /v1/language-models)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Instagram Graph API (Instagram Business/Creator account)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0
# Public HTTPS URL where this server is reachable (Instagram downloads the MP4 from PUBLIC_BASE_URL/renders/...)
PUBLIC_BASE_URL=

PORT=3000

# Cloudflare R2 storage (S3-compatible). If unset, files are stored on local disk under data/store.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
